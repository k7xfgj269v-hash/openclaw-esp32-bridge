# === Server Configuration ===

# Port the voice server listens on
SERVER_PORT=8080

# Bearer token required on every request (Authorization: Bearer <token>).
# Requests fail closed (401) when this is unset or the header does not match.
SERVER_TOKEN=

# === OpenClaw Binary ===

# Absolute path to the openclaw executable
OPENCLAW_BIN=/home/ubuntu/.npm-global/bin/openclaw

# PATH injected into subprocess environment so openclaw can locate its dependencies
OPENCLAW_PATH_ENV=/home/ubuntu/.npm-global/bin:/usr/bin:/bin

# === OpenClaw Agent ===

# Agent ID used when spawning OpenClaw sub-agent sessions
OPENCLAW_AGENT_ID=esp32-voice

# === Aliyun Bailian (DashScope) TTS — openclaw_subagent_server.py /voice ===

# API key for cosyvoice non-streaming TTS; /voice raises if empty
DASHSCOPE_API_KEY=
# CosyVoice model and voice (defaults shown)
DASHSCOPE_TTS_MODEL=cosyvoice-v3-flash
DASHSCOPE_TTS_VOICE=longxiaochun_v3
